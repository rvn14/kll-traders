APP_NAME=Items CRUD API
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=your_neon_database_url_here
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name_here
AZURE_STORAGE_ACCOUNT_KEY=your_storage_account_key_here
AZURE_BLOB_CONTAINER_NAME=items

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_API_VERSION=v23.0
# Set to true for template messages, false for plain text
WHATSAPP_USE_TEMPLATES=true